# Base parameters for simulationCases/dropMove-embed-pipe.c
# CaseNo >= 1000 keeps case folders sortable: simulationCases/c<CaseNo>/
CaseNo=1001
# Outer-fluid Reynolds number and emitted-product Peclet number
Re=0.01
Pe=1.6
# Refinement levels (domain is L0 x L0 with 2^MAXlevel cells across)
MAXlevel=8
MINlevel=0
# Clean capillary number, surface-tension slope and interface flux
Ca=0.1
GammaSlope=4.0
AcNum=1.0
# Inner-to-outer material-property ratios
viscosityRatio=1.0
densityRatio=1.0
L0=10.0
# Observation horizon and snapshot interval
tmax=50
tsnap=0.1
# Centroid displacement (drop radii) that classifies the run as MOVED; <= 0 disables early stop
threshold=0
# Adaptation tolerances
FErr=1e-3
VelErr=1e-3
cErr=1e-3
KErr=1e-3
# Kinetic-energy limit that classifies the run as FAILED
keLimit=1e3

# Embedded wall geometry and axial concentration seed
wallHalfWidth=2.53
dropOffset=0
initialDipole=1e-3
